# Copy to backend/.env and fill in. backend/.env is gitignored. Never commit real credentials.
#
# Two roles (least privilege):
#   DB_USERNAME / DB_PASSWORD                     -> runtime role: SELECT/INSERT/UPDATE/DELETE only
#   DB_MIGRATION_USERNAME / DB_MIGRATION_PASSWORD -> schema owner, used by Flyway for DDL
# If the migration variables are omitted, Flyway uses the runtime credentials.

# --- Local Docker database (`docker compose up -d` from the repo root) ---
DB_URL=jdbc:postgresql://localhost:5432/taskmanager
DB_USERNAME=taskmanager_app
DB_PASSWORD=taskmanager_app
DB_MIGRATION_USERNAME=taskmanager
DB_MIGRATION_PASSWORD=taskmanager

# --- Supabase ---
# Project → Connect → "Session pooler" (IPv4-friendly, supports prepared statements).
# Supabase shows a URI like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Split it into JDBC form (user and password go in their own variables):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_MIGRATION_USERNAME=postgres.<project-ref>
# DB_MIGRATION_PASSWORD=<your-database-password>
# For a separate runtime role, create it in the SQL editor:
#   CREATE ROLE taskmanager_app LOGIN PASSWORD '<strong-password>';
# then set DB_USERNAME=taskmanager_app.<project-ref> and DB_PASSWORD accordingly.
# (Migration V4 grants it data-only access.)

# --- Optional ---
# DB_SCHEMA=taskmanager
# DB_APP_ROLE=taskmanager_app
# DB_POOL_SIZE=5
# APP_TIME_ZONE=UTC        # team time zone for "overdue", IANA id e.g. Asia/Dhaka
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# If you use the *transaction* pooler (port 6543), append &prepareThreshold=0 to DB_URL.

# --- Authentication (session cookie) ---
# FRONTEND_URL=http://localhost:5173   # base of the password-reset links written to the log
# SESSION_TIMEOUT=12h                  # idle timeout of a sign-in session
# SESSION_COOKIE_SECURE=true           # set to true whenever the app is served over HTTPS

# --- Logging and authentication throttling ---
# APP_LOG_LEVEL=INFO                   # DEBUG enables routine read diagnostics
# LOGGING_FILE_NAME=logs/backend.log   # optional; otherwise console only
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_WINDOW=1m
# AUTH_ATTEMPTS_PER_IP=60
# AUTH_ATTEMPTS_PER_ACCOUNT=10
# AUTH_RATE_LIMIT_MAX_KEYS=10000
